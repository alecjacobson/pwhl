{
  "manifest_version": 3,
  "name": "PWHL on Google (Unofficial)",
  "version": "0.1.0",
  "description": "Unofficial extension — adds a PWHL games, standings, and players panel to Google Search results when you search for \"pwhl\".",
  "permissions": [],
  "host_permissions": [
    "https://lscluster.hockeytech.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PWHL on Google (Unofficial)"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*"],
      "js": ["src/api.js", "src/panel.js", "src/content.js"],
      "css": ["src/panel.css"],
      "run_at": "document_idle"
    }
  ]
}
